        {
            "name": "frp",
            "group": "network",
            "runtime": "ubuntu",
            "version": "0.71.0",
            "icon": "https://p2.so.qhimg.com/t02329536615c28bc32.png",
            "info": "在 Ubuntu Rootfs 中安装的内网穿透客户端 frpc（GitHub 官方 linux_arm64 版）：TCP/UDP/HTTP/HTTPS 穿透，把手机里的服务经公网节点暴露出去。安装时直连 GitHub 失败会自动换加速源（gh-proxy.com / ghfast.top / gh.acmsz.top）。",
            "show": true,
            "auto_install": false,
            "available": true,
            "downloads": [],
            "install": {
                "check_command": "command -v frpc >/dev/null 2>&1",
                "command": "export DEBIAN_FRONTEND=noninteractive\napt-get update && apt-get install -y curl ca-certificates tar || exit 1\nFRP_V=0.71.0\nFRP_URL=\"https://github.com/fatedier/frp/releases/download/v${FRP_V}/frp_${FRP_V}_linux_arm64.tar.gz\"\nFRP_OK=0\nfor FRP_M in \"\" \"https://gh-proxy.com/\" \"https://ghfast.top/\" \"https://gh.acmsz.top/\"\ndo\n  echo \"[lab] 下载 frp：${FRP_M:-直连}${FRP_URL}\"\n  if curl -fL --retry 2 --connect-timeout 15 --max-time 240 -o /tmp/frp.tar.gz \"${FRP_M}${FRP_URL}\" && tar -tzf /tmp/frp.tar.gz >/dev/null 2>&1\n  then\n    FRP_OK=1\n    echo \"[lab] 下载成功：${FRP_M:-直连（GitHub 官方）}\"\n    break\n  fi\n  echo \"[lab] 该源不可用，自动换下一个加速源\"\ndone\nif [ \"$FRP_OK\" != \"1\" ]; then\n  echo \"[lab] 所有下载源都失败；可先在实验室开「全局代理」再点安装\"\n  exit 1\nfi\nmkdir -p /root/frp /usr/local/bin\ntar -xzf /tmp/frp.tar.gz -C /tmp\ncp -f \"/tmp/frp_${FRP_V}_linux_arm64/frpc\" /root/frp/frpc\nchmod +x /root/frp/frpc\nln -sf /root/frp/frpc /usr/local/bin/frpc\nrm -rf /tmp/frp.tar.gz \"/tmp/frp_${FRP_V}_linux_arm64\"\nif [ ! -x /root/frp/frpc ]; then\n  echo \"[lab] frpc 未就位，安装失败\"\n  exit 1\nfi\nif ! command -v frpc >/dev/null 2>&1; then\n  echo \"[lab] frpc 不在 PATH（软链失败），安装失败\"\n  exit 1\nfi\nif ! /root/frp/frpc -v; then\n  echo \"[lab] frpc 无法运行（架构不符或缺运行库），安装失败\"\n  exit 1\nfi\necho \"[lab] frp 安装完成：直连失败会自动换加速源，卸载请在条目菜单点「卸载」\"",
                "mode": "terminal",
                "uninstall_command": "rm -rf /root/frp; rm -f /usr/local/bin/frpc '{package_dir}/.installed'; if command -v frpc >/dev/null 2>&1; then echo '[lab] frpc 仍可执行，卸载未完成'; false; else echo '[lab] frpc 已从 rootfs 移除（curl/tar 属共用包，保留）'; true; fi",
                "reset_command": "rm -rf /root/frp /tmp/frp_0.71.0_linux_arm64 /tmp/frp.tar.gz; rm -f /usr/local/bin/frpc '{package_dir}/.installed'; true"
            },
            "commands": [
                {
                    "id": "frpc_config",
                    "name": "启动客户端（配置文件）",
                    "description": "后台常驻；配置文件放共享存储里选",
                    "auto_execute": false,
                    "background": true,
                    "check_command": "pgrep -f '[f]rpc -c'",
                    "command": "exec frpc -c '{config_path}'",
                    "show_output": true,
                    "stop_command": "pkill -f '[f]rpc -c' 2>/dev/null; exit 0",
                    "variables": [
                        {
                            "key": "config_path",
                            "name": "配置文件",
                            "type": "file",
                            "default": "{sdcard}/WebHTV/frp/frpc.toml",
                            "hint": "选择 FRP 客户端配置文件",
                            "required": true,
                            "filter": "*.toml,*.ini"
                        }
                    ]
                },
                {
                    "id": "frpc_genconfig",
                    "name": "生成配置文件模板",
                    "description": "在 {sdcard}/WebHTV/frp/frpc.toml 生成带注释的 frpc 模板（serverAddr / auth.token 留空待填）；文件已存在则不覆盖",
                    "auto_execute": false,
                    "show_output": true,
                    "command": "FRPC_CFG='{sdcard}/WebHTV/frp/frpc.toml'\nmkdir -p \"$(dirname \"$FRPC_CFG\")\"\nif [ -f \"$FRPC_CFG\" ]; then\n  echo \"[lab] 已存在，未覆盖：$FRPC_CFG\"\nelse\n  cat > \"$FRPC_CFG\" <<'EOF_FRPC_TEMPLATE'\n# frpc 客户端配置（frp 0.71.0 TOML 格式）\n# 改完直接回条目点「启动客户端（配置文件）」；这个文件在手机共享存储里，用任意编辑器都能改\nserverAddr = \"这里填公网服务器 IP 或域名\"\nserverPort = 7000\n\n# 服务端配了 token 才需要这两行，且要和 frps.toml 里的 auth.token 一致；没有就删掉\nauth.method = \"token\"\nauth.token = \"这里填与服务端一致的 token\"\n\n# 示例一：TCP 穿透 —— 把手机 9978 端口暴露到服务器 6000\n[[proxies]]\nname = \"webhtv_tcp\"\ntype = \"tcp\"\nlocalIP = \"127.0.0.1\"\nlocalPort = 9978\nremotePort = 6000\n\n# 示例二：HTTP 穿透 —— 需要服务端配了 vhostHTTPPort 才有效，用时去掉下面注释\n# [[proxies]]\n# name = \"webhtv_http\"\n# type = \"http\"\n# localIP = \"127.0.0.1\"\n# localPort = 8901\n# customDomains = [\"你的域名\"]\nEOF_FRPC_TEMPLATE\n  echo \"[lab] 已生成模板：$FRPC_CFG\"\nfi\necho \"[lab] 用编辑器填好 serverAddr / auth.token 后，回条目点「启动客户端（配置文件）」\"\n"
                },
                {
                    "id": "frpc_tcp",
                    "name": "快速TCP穿透",
                    "auto_execute": false,
                    "command": "frpc tcp -s {server_addr}:{server_port} -t {token} -n {proxy_name} -l {local_port} -r {remote_port}",
                    "show_output": true,
                    "variables": [
                        {
                            "key": "server_addr",
