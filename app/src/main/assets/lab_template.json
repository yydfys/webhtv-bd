                            "hint": "服务器监听端口",
                            "required": true,
                            "min": 1024,
                            "max": 65535
                        },
                        {
                            "key": "www_dir",
                            "name": "Web根目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/WebHTV/wwwroot",
                            "hint": "静态文件目录",
                            "required": true
                        },
                        {
                            "key": "memory_limit",
                            "name": "内存占用大小",
                            "type": "number",
                            "default": 1024,
                            "hint": "内存限制(MB)",
