        {
            "name": "alist",
            "runtime": "ubuntu",
            "group": "tools",
            "version": "3.63.0",
            "icon": "https://wsrv.nl/?url=https://alist.nn.ci/logo.svg&w=240&h=240&output=png",
            "info": "一个支持多种存储的文件列表程序，支持阿里云盘、百度网盘、OneDrive等",
            "auto_install": false,
            "install_required": false,
            "show": true,
            "available": true,
            "downloads": [],
            "commands": [
                {
                    "id": "init_server",
                    "name": "第一步：初始化(必须)",
                    "description": "创建 /boot/alist/目录并拷贝alist二进制到私目录/alist/，给予可执行权限，为后续运行做准备！",
                    "command": "mkdir -p /boot/alist/ && cp {src_path} /boot/alist/alist && cd /boot/alist/ && chmod +x alist",
                    "auto_execute": false,
                    "show_output": true,
                    "variables": [
                        {
                            "key": "src_path",
                            "name": "alist文件路径",
                            "type": "file",
                            "default": "/storage/emulated/0/WebHTV/EnvFiles/alist",
                            "hint": "选择 alist 二进制文件",
                            "required": true,
                            "filter": "*"
                        }
                    ]
                },
                {
                    "id": "server",
                    "name": "第二步：启动服务",
                    "description": "启动 AList 文件服务器",
                    "command": "cd /boot/alist/ && ./alist server --data {data_dir}",
                    "check_command": "pgrep -f '[a]list server'",
                    "stop_command": "pkill -f '[a]list server' 2>/dev/null; fuser -k 5244/tcp 2>/dev/null; exit 0",
                    "auto_execute": false,
                    "show_output": false,
                    "background": true,
                    "variables": [
                        {
                            "key": "data_dir",
                            "name": "数据目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/WebHTV/EnvFiles/config/alist/",
                            "hint": "AList 数据存储目录",
                            "required": true
                        }
                    ],
                    "clicks": [
                        {
                            "title": "浏览首页",
                            "action": "webview",
                            "value": "http://127.0.0.1:5244",
                            "style": "dialog"
                        },
                        {
                            "title": "后台管理",
                            "action": "webview",
                            "value": "http://127.0.0.1:5244/@manage",
                            "style": "dialog"
                        },
                        {
                            "title": "复制地址",
                            "action": "copy",
                            "value": "http://127.0.0.1:5244"
                        }
                    ]
                },
                {
                    "id": "admin",
                    "name": "设置管理员密码",
                    "description": "设置管理员密码",
                    "command": "/boot/alist/alist admin set {password} --data {data_dir}",
                    "auto_execute": false,
                    "show_output": true,
                    "variables": [
                        {
                            "key": "password",
                            "name": "管理员密码",
                            "type": "text",
                            "default": "admin123",
                            "hint": "设置管理员登录密码",
                            "required": true
                        },
                        {
                            "key": "data_dir",
                            "name": "数据目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/WebHTV/EnvFiles/config/alist/",
                            "hint": "AList 数据存储目录",
                            "required": true
                        }
                    ]
                },
                {
                    "id": "random_pwd",
                    "name": "随机生成新密码",
                    "description": "生成随机管理员密码",
                    "command": "/boot/alist/alist admin random --data {data_dir}",
                    "auto_execute": false,
                    "show_output": true,
                    "variables": [
                        {
                            "key": "data_dir",
                            "name": "数据目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/WebHTV/EnvFiles/config/alist/",
                            "hint": "AList 数据存储目录",
                            "required": true
                        }
                    ]
                },
                {
                    "id": "config_port",
                    "name": "修改配置端口(vi命令)",
                    "description": "修改 AList 配置文件config.json里的端口：\n\"scheme\": {\n    \"address\": \"0.0.0.0\",\n    \"http_port\": 5244,    // ← 就改这个数字}\n修改后操作说明：\n键盘的 方向键（↑↓←→） 移动光标到 \"http_port\": 5244 ，\n保存并退出（最常用） Esc → : → wq → 回车。\n只保存，不退出（继续编辑） Esc → : → w → 回车。\n强制保存并退出（权限不够时用） Esc → : → wq! → 回车。\n放弃修改，强制退出（改乱了想重来） Esc → : → q! → 回车。",
                    "command": "vi {data_dir}/config.json",
                    "auto_execute": false,
                    "show_output": true,
                    "variables": [
                        {
                            "key": "data_dir",
                            "name": "数据目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/WebHTV/EnvFiles/config/alist/",
                            "hint": "AList 数据存储目录",
                            "required": true
                        }
                    ]
                },
                {
                    "id": "config_port2",
                    "name": "修改配置端口(nano命令)",
                    "description": "修改 AList 配置文件config.json里的端口：\n\"scheme\": {\n    \"address\": \"0.0.0.0\",\n    \"http_port\": 5244,    // ← 就改这个数字}\n修改后操作说明：\n键盘的 方向键（↑↓←→） 移动光标到 \"http_port\": 5244 ，\n这里保存并退出（最常用）: Ctrl+O → 回车 → Ctrl+X，\n直接退出（不保存） Ctrl+X → 屏幕提示是否保存时，按 N（No），\n搜索某个关键词 Ctrl+W，输入关键词（如 http_port），按回车跳转",
                    "command": "nano {data_dir}/config.json",
                    "auto_execute": false,
                    "show_output": true,
                    "variables": [
                        {
                            "key": "data_dir",
                            "name": "数据目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/WebHTV/EnvFiles/config/alist/",
                            "hint": "AList 数据存储目录",
                            "required": true
                        }
                    ]
                },
                {
                    "id": "stop_alist",
                    "name": "停止 Alist 服务",
                    "description": "停止所有正在运行的 Alist 进程",
                    "command": "pkill -f '[a]list' 2>/dev/null && echo '✅ Alist 已停止' || echo '❌ 没有运行的 Alist 进程'; exit 0",
                    "auto_execute": false,
                    "show_output": true
                },
                {
                    "id": "version",
                    "name": "查看版本",
                    "description": "显示 AList 版本信息",
                    "command": "/boot/alist/alist version",
                    "auto_execute": false,
                    "show_output": true
                },
                {
                    "id": "help",
                    "name": "查看帮助",
                    "description": "显示 AList 帮助信息",
                    "command": "/boot/alist/alist help",
                    "auto_execute": false,
                    "show_output": true
                }
            ]
        },
        {
            "name": "aria2",
            "group": "network",
            "runtime": "ubuntu",
            "version": "1.37.0",
            "icon": "https://wsrv.nl/?url=https://store-images.s-microsoft.com/image/apps.11619.14635839640377203.9a7358e8-a286-4e0f-964a-606f3d488405.9df10642-71e6-4181-98b9-e96899a98b92&w=240&h=240&output=png",
            "info": "在 Ubuntu Rootfs 中用 apt 安装的下载器 aria2c：支持 HTTP/HTTPS、FTP、SFTP、BitTorrent、Metalink，可开 RPC 远程下载、断点续传。",
            "show": true,
            "auto_install": false,
            "available": true,
            "downloads": [],
            "install": {
                "check_command": "command -v aria2c >/dev/null 2>&1",
                "command": "export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y aria2 curl ca-certificates && mkdir -p '{sdcard}/WebHTV/aria2' && command -v aria2c >/dev/null 2>&1 && echo \"[lab] aria2c 已就位：$(aria2c --version | head -1)\"",
                "mode": "terminal",
                "uninstall_command": "export DEBIAN_FRONTEND=noninteractive; __p=$(dpkg -l 2>/dev/null | awk '$1 ~ /^i/ || $1==\"rc\" {print $2}' | grep -E '^aria2$|^libaria2' | tr '\\n' ' '); echo \"[lab] 待卸载 aria2 包: ${__p:-（无）}\"; [ -n \"$__p\" ] && apt-get purge -y $__p; apt-get autoremove -y; rm -f '{package_dir}/.installed'; if command -v aria2c >/dev/null 2>&1; then echo '[lab] aria2c 仍在 rootfs，卸载未完成'; false; else echo '[lab] aria2c 已从 rootfs 移除'; true; fi",
                "reset_command": "export DEBIAN_FRONTEND=noninteractive; __p=$(dpkg -l 2>/dev/null | awk '$1 ~ /^i/ || $1==\"rc\" {print $2}' | grep -E '^aria2$|^libaria2' | tr '\\n' ' '); [ -n \"$__p\" ] && apt-get purge -y $__p; apt-get autoremove -y >/dev/null 2>&1; rm -f '{package_dir}/.installed'; true"
            },
            "commands": [
                {
                    "id": "aria2_rpc",
                    "name": "启动 RPC 服务",
                    "description": "后台常驻，端口/密钥/目录可改；停止按钮一键收工",
                    "auto_execute": false,
                    "background": true,
                    "check_command": "pgrep -f '[a]ria2c --enable-rpc'",
                    "command": "exec aria2c --enable-rpc --rpc-listen-all=true --rpc-listen-port={port} --rpc-secret={secret} --continue=true --max-concurrent-downloads={max_jobs} -d '{download_dir}'",
                    "show_output": true,
                    "stop_command": "pkill -f '[a]ria2c --enable-rpc' 2>/dev/null; fuser -k {port}/tcp 2>/dev/null; exit 0",
                    "variables": [
                        {
                            "key": "port",
                            "name": "RPC端口",
                            "type": "number",
                            "default": 6800,
                            "hint": "RPC 监听端口",
                            "required": true,
                            "min": 1024,
                            "max": 65535
                        },
                        {
                            "key": "secret",
                            "name": "RPC密钥",
                            "type": "text",
                            "default": "aria2secret",
                            "hint": "RPC 访问密钥（token）",
                            "required": false
                        },
                        {
                            "key": "download_dir",
                            "name": "下载目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/Download",
                            "hint": "文件下载保存目录",
                            "required": true
                        },
                        {
                            "key": "max_jobs",
                            "name": "最大并发数",
