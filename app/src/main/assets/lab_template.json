                "mode": "terminal",
                "uninstall_command": "export DEBIAN_FRONTEND=noninteractive; __p=$(dpkg -l 2>/dev/null | awk '$1 ~ /^i/ || $1==\"rc\" {print $2}' | grep -E '^node' | tr '\\n' ' '); echo \"[lab] 待卸载 node 包: ${__p:-（无）}\"; [ -n \"$__p\" ] && apt-get purge -y $__p; apt-get autoremove -y; rm -f /etc/apt/sources.list.d/nodesource.list /etc/apt/sources.list.d/nodesource.sources /etc/apt/keyrings/nodesource.gpg /usr/share/keyrings/nodesource.gpg; rm -rf /usr/lib/node_modules /usr/local/lib/node_modules /root/.npm /root/.node-gyp; rm -f '{package_dir}/.installed'; if command -v node >/dev/null 2>&1; then echo '[lab] node 仍在 rootfs，卸载未完成'; false; else echo '[lab] node 已从 rootfs 移除'; true; fi",
                "reset_command": "export DEBIAN_FRONTEND=noninteractive; __p=$(dpkg -l 2>/dev/null | awk '$1 ~ /^i/ || $1==\"rc\" {print $2}' | grep -E '^node' | tr '\\n' ' '); [ -n \"$__p\" ] && apt-get purge -y $__p; apt-get autoremove -y >/dev/null 2>&1; rm -f '{package_dir}/.installed'; true"
            },
