    "lists": [
        {
            "name": "php",
            "runtime": "ubuntu",
            "group": "runtime",
            "icon": "https://img.icons8.com/?size=240&id=121463&format=png&color=000000",
            "info": "在 Ubuntu Rootfs 中独立安装并运行 PHP CLI，wwwroot 目录会被php、python环境共用，卸载单个环境时不会删除目录本身，只清理自身文件。",
            "show": true,
            "version": "8.3.6",
            "auto_install": false,
            "available": true,
            "downloads": [],
            "install": {
                "check_command": "test -f '{package_dir}/.installed' && command -v php >/dev/null 2>&1",
                "command": "export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y php-cli && mkdir -p '/storage/emulated/0/WebHTV/wwwroot' && printf '%s\\n' '<?php echo \"Hello from Ubuntu PHP \" . PHP_VERSION;' > '/storage/emulated/0/WebHTV/wwwroot/index.php' && touch '{package_dir}/.installed'",
                "mode": "terminal",
                "uninstall_command": "export DEBIAN_FRONTEND=noninteractive; __p=$(dpkg -l 2>/dev/null | awk '$1 ~ /^i/ || $1==\"rc\" {print $2}' | grep -E '^php' | tr '\\n' ' '); echo \"[lab] 待卸载 php 包: ${__p:-（无）}\"; [ -n \"$__p\" ] && apt-get purge -y $__p; apt-get autoremove -y; rm -f '/storage/emulated/0/WebHTV/wwwroot/index.php'; rm -f '{package_dir}/.installed'; if command -v php >/dev/null 2>&1; then echo '[lab] php 仍在 rootfs，卸载未完成'; false; else echo '[lab] php 已从 rootfs 移除'; true; fi",
                "reset_command": "export DEBIAN_FRONTEND=noninteractive; __p=$(dpkg -l 2>/dev/null | awk '$1 ~ /^i/ || $1==\"rc\" {print $2}' | grep -E '^php' | tr '\\n' ' '); [ -n \"$__p\" ] && apt-get purge -y $__p; apt-get autoremove -y >/dev/null 2>&1; rm -f '{package_dir}/.installed'; true"
            },
            "commands": [
                {
                    "id": "php_server",
                    "name": "启动 PHP Web服务",
                    "auto_execute": true,
                    "background": true,
                    "show_output": true,
                    "check_command": "pgrep -f '[p]hp -S 0.0.0.0:{port}'",
                    "command": "php -S 0.0.0.0:{port} -t {www_dir} -d memory_limit={memory_limit}M",
                    "stop_command": "pkill -f '[p]hp -S 0.0.0.0:{port}' 2>/dev/null; fuser -k {port}/tcp 2>/dev/null; exit 0",
                    "variables": [
                        {
                            "key": "port",
                            "name": "端口号",
                            "type": "number",
                            "default": 8901,
                            "hint": "服务器监听端口",
                            "required": true,
                            "min": 1024,
                            "max": 65535
                        },
                        {
                            "key": "www_dir",
                            "name": "Web根目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/WebHTV/wwwroot",
                            "hint": "php文件目录",
                            "required": true
                        },
                        {
                            "key": "memory_limit",
                            "name": "内存占用大小",
                            "type": "number",
                            "default": 1024,
                            "hint": "内存限制(MB)",
                            "required": true,
                            "min": 8,
                            "max": 2048
                        }
                    ]
                },
                {
                    "id": "stop_php",
                    "name": "⭕️ 停止所有PHP服务",
                    "command": "pkill -f 'php -S'",
                    "auto_execute": false,
                    "show_output": true
                },
                {
                    "id": "php_version",
                    "name": "查看 PHP 版本",
                    "auto_execute": false,
                    "command": "php -v",
                    "show_output": true
                }
            ]
        },
        {
            "name": "python3",
            "group": "runtime",
            "runtime": "ubuntu",
            "icon": "https://img.icons8.com/?size=240&id=13441&format=png&color=000000",
            "info": "在 Ubuntu Rootfs 中独立安装并运行 Python3，wwwroot 目录会被php、python环境共用，卸载单个环境时不会删除目录本身，只清理自身文件。",
            "show": true,
            "version": "3.12.3",
            "auto_install": false,
            "available": true,
            "downloads": [],
            "install": {
                "check_command": "test -f '{package_dir}/.installed' && command -v python3 >/dev/null 2>&1",
                "command": "export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y python3 && mkdir -p '/storage/emulated/0/WebHTV/wwwroot' && printf '%s\\n' '<!doctype html><meta charset=\"utf-8\"><h1>Hello from Ubuntu Python3</h1>' > '/storage/emulated/0/WebHTV/wwwroot/index.html' && touch '{package_dir}/.installed'",
                "mode": "terminal",
                "uninstall_command": "export DEBIAN_FRONTEND=noninteractive; __p=$(dpkg -l 2>/dev/null | awk '$1 ~ /^i/ || $1==\"rc\" {print $2}' | grep -E '^python3' | tr '\\n' ' '); echo \"[lab] 待卸载 python3 包: ${__p:-（无）}\"; [ -n \"$__p\" ] && apt-get purge -y $__p; apt-get autoremove -y; rm -rf /usr/local/lib/python3* /usr/local/bin/pip /usr/local/bin/pip3* /root/.cache/pip; rm -f '/storage/emulated/0/WebHTV/wwwroot/index.html'; rm -f '{package_dir}/.installed'; if command -v python3 >/dev/null 2>&1; then echo '[lab] python3 仍在 rootfs，卸载未完成'; false; else echo '[lab] python3 已从 rootfs 移除'; true; fi",
                "reset_command": "export DEBIAN_FRONTEND=noninteractive; __p=$(dpkg -l 2>/dev/null | awk '$1 ~ /^i/ || $1==\"rc\" {print $2}' | grep -E '^python3' | tr '\\n' ' '); [ -n \"$__p\" ] && apt-get purge -y $__p; apt-get autoremove -y >/dev/null 2>&1; rm -f '{package_dir}/.installed'; true"
            },
            "commands": [
                {
                    "id": "python_server",
                    "name": "启动 Python3 Web服务",
                    "auto_execute": false,
                    "background": true,
                    "check_command": "pgrep -f '[p]ython3 -m http.server {server}'",
                    "command": "ulimit -v $(({memory_limit} * 1024)) && exec python3 -m http.server {server} --bind 0.0.0.0 --directory '{www_dir}'",
                    "show_output": true,
                    "stop_command": "pkill -f '[p]ython3 -m http.server {server}' 2>/dev/null; fuser -k {server}/tcp 2>/dev/null; exit 0",
                    "variables": [
                        {
                            "key": "server",
                            "name": "端口号",
                            "type": "number",
                            "default": 8902,
                            "hint": "服务器监听端口",
                            "required": true,
                            "min": 1024,
                            "max": 65535
                        },
                        {
                            "key": "www_dir",
                            "name": "Web根目录",
                            "type": "directory",
                            "default": "/storage/emulated/0/WebHTV/wwwroot",
                            "hint": "php文件目录",
                            "required": true
                        },
                        {
                            "key": "memory_limit",
                            "name": "内存占用大小",
                            "type": "number",
                            "default": 1024,
                            "hint": "内存限制(MB)",
                            "required": true,
                            "min": 8,
                            "max": 2048
                        }
                    ]
                },
                {
                    "id": "python_version",
                    "name": "查看 Python3 版本",
                    "auto_execute": false,
                    "command": "python3 --version",
                    "show_output": true
                }
            ]
        },
        {
            "name": "nodejs",
            "runtime": "ubuntu",
            "group": "runtime",
            "icon": "https://img.icons8.com/?size=240&id=hsPbhkOH4FMe&format=png&color=000000",
