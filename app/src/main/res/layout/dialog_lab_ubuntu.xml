<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="13sp"
            android:textColor="@color/lab_text_secondary"
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未安装"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/progressBox"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.google.android.material.textview.MaterialTextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="准备中..."/>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                app:trackCornerRadius="2dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.google.android.material.button.MaterialButton
                android:textSize="13sp"
                android:id="@+id/installButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="安装"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="13sp"
                android:id="@+id/uninstallButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="卸载"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.google.android.material.button.MaterialButton
            android:textSize="13sp"
            android:id="@+id/terminalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="打开 Ubuntu 终端"/>
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="13sp"
            android:textColor="#1976d2"
            android:id="@+id/advancedToggle"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="高级设置 ▾"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/advancedBox"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/releaseLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="发行版本"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="#1976d2"
                app:hintTextColor="#1976d2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <AutoCompleteTextView
                    android:textSize="14sp"
                    android:textColor="@color/lab_text_primary"
                    android:id="@+id/releaseDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/rootfsSourceLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rootfs 镜像源"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="#1976d2"
                app:hintTextColor="#1976d2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <AutoCompleteTextView
                    android:textSize="14sp"
                    android:textColor="@color/lab_text_primary"
                    android:id="@+id/rootfsSourceDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/rootfsUrlLayout"
                android:textColorHint="@color/lab_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="自定义 Rootfs URL"
                android:visibility="gone"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="#1976d2"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1976d2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="13sp"
                    android:textColor="@color/lab_text_primary"
                    android:id="@+id/rootfsUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:maxLines="3"
                    android:inputType="textUri"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/aptSourceLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="apt 软件源"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="#1976d2"
                app:hintTextColor="#1976d2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <AutoCompleteTextView
                    android:textSize="14sp"
                    android:textColor="@color/lab_text_primary"
                    android:id="@+id/aptSourceDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/aptUrlLayout"
                android:textColorHint="@color/lab_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="自定义 apt 源（如 https://mirrors.aliyun.com/ubuntu-ports/）"
                android:visibility="gone"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="#1976d2"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1976d2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="13sp"
                    android:textColor="@color/lab_text_primary"
                    android:id="@+id/aptUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:maxLines="2"
                    android:inputType="textUri"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/sharedStorageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/lab_text_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="共享手机存储"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/lab_text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="开启后容器内 /sdcard 指向手机存储"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sharedStorageSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="11sp"
            android:textColor="@color/lab_text_secondary"
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rootfs 与已安装软件位于应用私有目录，卸载应用即清除；手机共享存储与 lab 配置不受影响。"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</ScrollView>
