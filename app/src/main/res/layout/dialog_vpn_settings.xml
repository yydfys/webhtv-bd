<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- 状态说明 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/status"
            style="@style/Widget.WebHTV.LightDialog.Helper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/vpn_state_off" />

        <!-- 订阅地址 + 扫码推送 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/subUrlLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/lab_sub_url_hint"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/subUrl"
                    android:layout_width="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusDown="@id/autoStartSwitch"
                    android:nextFocusRight="@id/qrBtn"
                    android:nextFocusUp="@id/autoStartSwitch"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:textColor="@color/lab_panel_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/qrBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/sel_focus_round"
                android:clickable="true"
                android:contentDescription="扫码推送订阅"
                android:focusable="true"
                android:nextFocusDown="@id/autoStartSwitch"
                android:nextFocusLeft="@id/subUrl"
                android:nextFocusUp="@id/autoStartSwitch"
                android:padding="6dp"
                android:src="@drawable/ic_remote_qr"
                android:tint="@color/lab_panel_accent" />

            <!-- v591 TV only: Save subscription (mobile keeps it gone) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveSubBtn"
                style="@style/Widget.WebHTV.LightDialog.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/vpn_save_sub"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- mihomo 自启动开关（仅 TV 显示，与手动代理开关互斥） -->
        <LinearLayout
            android:id="@+id/autoStartRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/autoStartTitle"
                    style="@style/Widget.WebHTV.LightDialog.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lab_mihomo_autostart_title" />

                <TextView
                    android:id="@+id/autoStartHint"
                    style="@style/Widget.WebHTV.LightDialog.Helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/lab_mihomo_autostart_hint" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoStartSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:nextFocusDown="@id/mihomoSwitch"
                android:nextFocusUp="@id/subUrl" />
        </LinearLayout>

<LinearLayout
            android:id="@+id/mihomoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mihomoTitle"
                    style="@style/Widget.WebHTV.LightDialog.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lab_mihomo_title" />

                <TextView
                    android:id="@+id/mihomoHint"
                    style="@style/Widget.WebHTV.LightDialog.Helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/lab_mihomo_hint" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mihomoSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:nextFocusDown="@id/vpnSwitch"
                android:nextFocusUp="@id/autoStartSwitch" />
        </LinearLayout>
<LinearLayout
            android:id="@+id/killRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/killTitle"
                    style="@style/Widget.WebHTV.LightDialog.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="杀死 mihomo 进程" />

                <TextView
                    android:id="@+id/killHint"
                    style="@style/Widget.WebHTV.LightDialog.Helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="彻底结束内核进程，并复位上方两个开关" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/killSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:nextFocusDown="@id/nodeRow"
                android:nextFocusUp="@id/mihomoRow" />
        </LinearLayout>

<LinearLayout
            android:id="@+id/vpnRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/vpnTitle"
                    style="@style/Widget.WebHTV.LightDialog.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lab_system_vpn_title" />

                <TextView
                    android:id="@+id/vpnHint"
                    style="@style/Widget.WebHTV.LightDialog.Helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/lab_system_vpn_hint" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/vpnSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:nextFocusDown="@id/nodeRow"
                android:nextFocusUp="@id/mihomoSwitch" />
        </LinearLayout>

<LinearLayout
            android:id="@+id/nodeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@id/positive"
            android:nextFocusUp="@id/mihomoSwitch"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nodeTitle"
                    style="@style/Widget.WebHTV.LightDialog.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/node_manage_title" />

                <TextView
                    android:id="@+id/nodeHint"
                    style="@style/Widget.WebHTV.LightDialog.Helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/node_manage_hint" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textColor="@color/lab_panel_text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/negative"
                style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:nextFocusRight="@id/positive"
                android:nextFocusUp="@id/nodeRow"
                android:text="@string/dialog_negative"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/positive"
                style="@style/Widget.WebHTV.LightDialog.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:nextFocusLeft="@id/negative"
                android:nextFocusUp="@id/nodeRow"
                android:text="@string/dialog_positive"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
